---
const technologies = [
  "PHP",
  "Javascript",
  "MySQL",
  "HTML",
  "css",
  "sass",
  "Tailwind",
  "Figma",
  "Node",
  "MongoDB",
  "React",
  "Vue",
  "Angular",
  "Astro",
  "Claude Sonnet 4",
  "Chat-GPT",
  "Gemini 2.5",
  "ComfyUI",
  "LLM's",
  "Python",
  "Flux",
  "Veo",
  "NotebookLM",
];

const getTechColor = (tech: string): string => {
  const colors: { [key: string]: string } = {
    PHP: "border-2 border-indigo-300 text-indigo-300 roboto-regular hover:bg-indigo-300 hover:text-white",
    Javascript:
      "border-2 border-yellow-500 text-yellow-500 roboto-regular hover:bg-yellow-500 hover:text-white",
    MySQL:
      "border-2 border-blue-600 text-blue-600 roboto-regular hover:bg-blue-600 hover:text-white",
    HTML: "border-2 border-amber-500 text-amber-500 roboto-regular hover:bg-amber-500 hover:text-white",
    css: "border-2 border-blue-400 text-blue-400 roboto-regular hover:bg-blue-400 hover:text-white",
    sass: "border-2 border-pink-400 text-pink-400 roboto-regular hover:bg-pink-400 hover:text-white",
    Tailwind:
      "border-2 border-sky-600 text-sky-600 roboto-regular hover:bg-sky-600 hover:text-white",
    Figma:
      "border-2 border-rose-600 text-rose-600 roboto-regular hover:bg-rose-600 hover:text-white",
    Node: "border-2 border-lime-600 text-lime-600 roboto-regular hover:bg-lime-600 hover:text-white",
    MongoDB:
      "border-2 border-green-400 text-green-400 roboto-regular hover:bg-green-400 hover:text-white",
    React:
      "border-2 border-cyan-500 text-cyan-500 roboto-regular hover:bg-cyan-500 hover:text-white",
    Vue: "border-2 border-emerald-500 text-emerald-500 roboto-regular hover:bg-emerald-500 hover:text-white",
    Angular:
      "border-2 border-red-600 text-red-600 roboto-regular hover:bg-red-600 hover:text-white",
    Astro:
      "border-2 border-orange-500 text-orange-500 roboto-regular hover:bg-orange-500 hover:text-white",
    "Claude Sonnet 4":
      "border-2 border-purple-600 text-purple-600 roboto-regular hover:bg-purple-600 hover:text-white",
    "Chat-GPT":
      "border-2 border-green-600 text-green-600 roboto-regular hover:bg-green-600 hover:text-white",
    "Gemini 2.5":
      "border-2 border-blue-500 text-blue-500 roboto-regular hover:bg-blue-500 hover:text-white",
    ComfyUI:
      "border-2 border-pink-600 text-pink-600 roboto-regular hover:bg-pink-600 hover:text-white",
    "LLM's":
      "border-2 border-violet-600 text-violet-600 roboto-regular hover:bg-violet-600 hover:text-white",
    Python:
      "border-2 border-yellow-600 text-yellow-600 roboto-regular hover:bg-yellow-600 hover:text-white",
    Flux:
      "border-2 border-teal-600 text-teal-600 roboto-regular hover:bg-teal-600 hover:text-white",
    Veo:
      "border-2 border-red-500 text-red-500 roboto-regular hover:bg-red-500 hover:text-white",
    NotebookLM:
      "border-2 border-orange-600 text-orange-600 roboto-regular hover:bg-orange-600 hover:text-white",
  };
  return (
    colors[tech] ||
    "border-2 border-zinc-600 text-zinc-600 roboto-regular hover:bg-zinc-600 hover:text-white"
  );
};
---

<section id="experience" class="md:w-3/4 m-auto my-20 p-8">
  <!-- Primera fila: Tarjeta de IA centrada -->
  <div class="flex justify-center mb-10">
    <div class="border border-zinc-600 p-10 rounded-2xl max-w-2xl w-full">
      <h3 class="text-lg text-indigo-800">Cerdá Group</h3>
      <h2 class="text-3xl text-black">Responsable de Innovación en Inteligencia Artificial</h2>
      <h5 class="text-sm roboto-regular-italic">Enero 2025 - Hoy</h5>
      <p class="my-4 text-base text-zinc-500">
        Experiencia laboral. Dentro del equipo de Digital Business, desarrollo la incorporación de Inteligencia Artificial en proyectos de desarrollo web, marketing y generación de contenidos. He implementado soluciones basadas en IA para automatizar procesos internos, optimizar flujos de trabajo y potenciar la creatividad en campañas digitales. Entre los avances más destacados se incluyen sistemas de generación de imágenes y vídeos, asistentes inteligentes para uso interno y el desarrollo de herramientas personalizadas que combinan IA con las plataformas de la empresa.
      </p>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class={`${getTechColor("Claude Sonnet 4")} px-2 py-1 text-xs cursor-default`}>
          Claude Sonnet 4
        </span>

        <span
          class={`${getTechColor("Chat-GPT")} px-2 py-1 text-xs cursor-default`}
        >
          Chat-GPT
        </span>

        <span
          class={`${getTechColor("Gemini 2.5")} px-2 py-1 text-xs cursor-default`}
        >
          Gemini 2.5
        </span>

        <span
          class={`${getTechColor("ComfyUI")} px-2 py-1 text-xs cursor-default`}
        >
          ComfyUI
        </span>

        <span
          class={`${getTechColor("Python")} px-2 py-1 text-xs cursor-default`}
        >
          Python
        </span>

        <span
          class={`${getTechColor("Flux")} px-2 py-1 text-xs cursor-default`}
        >
          Flux
        </span>

        <span
          class={`${getTechColor("Veo")} px-2 py-1 text-xs cursor-default`}
        >
          Veo
        </span>

        <span
          class={`${getTechColor("NotebookLM")} px-2 py-1 text-xs cursor-default`}
        >
          NotebookLM
        </span>
      </div>
    </div>
  </div>

  <!-- Segunda fila: Otras dos tarjetas -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-10 text-base text-zinc-500"
  >

    <div class="border border-zinc-600 p-10 rounded-2xl">
      <h3 class="text-lg text-indigo-800">Cerdá Group</h3>
      <h2 class="text-3xl text-black">Frontend & Ux/Ui Designer</h2>
      <h5 class="text-sm roboto-regular-italic">Enero 2024 - Diciembre 2024</h5>
      <p class="my-4">
        Experiencia laboral. Durante un año y medio he trabajado como desarrollador frontend formando parte del equipo de Digital Business y desarrollando parte de la intranet de la empresa.
      </p>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class={`${getTechColor("PHP")} px-2 py-1 text-xs cursor-default`}>
          PHP
        </span>

        <span
          class={`${getTechColor("MySQL")} px-2 py-1 text-xs cursor-default`}
        >
          MySQL
        </span>

        <span
          class={`${getTechColor("Javascript")} px-2 py-1 text-xs cursor-default`}
        >
          Javascript
        </span>

        <span
          class={`${getTechColor("HTML")} px-2 py-1 text-xs cursor-default`}
        >
          HTML
        </span>

        <span class={`${getTechColor("css")} px-2 py-1 text-xs cursor-default`}>
          css
        </span>

        <span
          class={`${getTechColor("sass")} px-2 py-1 text-xs cursor-default`}
        >
          sass
        </span>

        <span
          class={`${getTechColor("Tailwind")} px-2 py-1 text-xs cursor-default`}
        >
          Tailwind
        </span>

        <span
          class={`${getTechColor("Figma")} px-2 py-1 text-xs cursor-default`}
        >
          Figma
        </span>
      </div>
    </div>

    <div class="border border-zinc-600 p-10 rounded-2xl">
      <h3 class="text-lg text-indigo-800">Freelance</h3>
      <h2 class="text-3xl text-black">Desarrollador Full Stack</h2>
      <h5 class="text-sm roboto-regular-italic">Mayo 2023 - Enero 2024</h5>
      <p class="my-4">
        Experiencia no laboral. Desarrollo de proyectos a pequeña escala para
        mejorar la lógica de programación y poder seguir aprendiendo. En esta
        etapa he ido trabajando con distintas tecnologías.
      </p>
      <div class="flex flex-wrap gap-2 mb-3">
        <span
          class={`${getTechColor("React")} px-2 py-1 text-xs cursor-default`}
        >
          React
        </span>

        <span
          class={`${getTechColor("Javascript")} px-2 py-1 text-xs cursor-default`}
        >
          Javascript
        </span>

        <span
          class={`${getTechColor("HTML")} px-2 py-1 text-xs cursor-default`}
        >
          HTML
        </span>

        <span class={`${getTechColor("css")} px-2 py-1 text-xs cursor-default`}>
          css
        </span>

        <span
          class={`${getTechColor("Tailwind")} px-2 py-1 text-xs cursor-default`}
        >
          Tailwind
        </span>

        <span
          class={`${getTechColor("Node")} px-2 py-1 text-xs cursor-default`}
        >
          Node
        </span>

        <span
          class={`${getTechColor("MongoDB")} px-2 py-1 text-xs cursor-default`}
        >
          MongoDB
        </span>

        <span
          class={`${getTechColor("Figma")} px-2 py-1 text-xs cursor-default`}
        >
          Figma
        </span>

        <span
          class={`${getTechColor("Express")} px-2 py-1 text-xs cursor-default`}
        >
          Express
        </span>

        <span
          class={`${getTechColor("Figma")} px-2 py-1 text-xs cursor-default`}
        >
          Astro
        </span>
      </div>
    </div>
  </div>
</section>
